{
  "name": "zoneskein",
  "version": "0.1.0",
  "private": true,
  "description": "A static-first DNS inspection, validation, and record-authoring workbench.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript7/bin/tsc -b && vite build && node scripts/build-source-archive.ts && node scripts/verify-build.ts",
    "generate:favicon": "node scripts/generate-favicon.ts",
    "check:build": "node scripts/verify-build.ts",
    "preview": "vite preview",
    "check": "node ./node_modules/typescript7/bin/tsc -b --pretty false",
    "check:dnssec-anchors": "node scripts/check-root-anchors.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "security:codeql": "node scripts/run-codeql.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=4 --testTimeout=30000",
    "test:a11y": "playwright test --project accessibility-chromium",
    "test:e2e": "playwright test",
    "test:e2e:stress": "playwright test --project=chromium --project=mobile-chromium --workers=1 --retries=0 --repeat-each=5",
    "test:live": "node scripts/live-smoke.ts"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@dnsquery/dns-packet": "6.1.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@noble/curves": "2.4.0",
    "@peculiar/asn1-schema": "2.9.4",
    "@peculiar/asn1-x509": "2.9.4",
    "cidr-tools": "13.0.1",
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "ipaddr.js": "2.5.0",
    "marked-react": "4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3-drag": "3.0.7",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.1",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "marked": "18.0.13",
    "prettier": "3.9.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
