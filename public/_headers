/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://dns.google https://cloudflare-dns.com https://dns.quad9.net; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/LICENSE
  Content-Type: text/plain; charset=UTF-8

/*.md
  Content-Type: text/markdown; charset=UTF-8

/SOURCE_SHA256
  Content-Type: text/plain; charset=UTF-8
